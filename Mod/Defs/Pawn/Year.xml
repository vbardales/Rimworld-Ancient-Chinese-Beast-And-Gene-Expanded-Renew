    </graphicData>
    <projectile>
      <speed>100</speed>
      <damageDef>Flame</damageDef>
      <damageAmountBase>8</damageAmountBase>
      <armorPenetrationBase>1</armorPenetrationBase>
    </projectile>
  </ThingDef>
  
  
