<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="SZBeastParent">
    <defName>SZ_YearBeast</defName>
    <label>nian beast</label>
    <description>The nian beast is something close to a demon in traditional Chinese myth, and next to nothing is known about it. This one cannot be tamed. It is thickly armoured, and its fangs and claws alike do enormous damage to anything it hunts. On top of that it breathes deadly fire. \n\nAlmost nobody on the rim has seen the thing. Shenzhou traders say it attacks colonists often, and will break down a door to reach someone indoors. Its weakness is that it fears fire and loud noise, so firecrackers hold it in check. (Any weapon other than a firecracker does only 10% of its damage to it.)</description>
    <descriptionHyperlinks>
      <ThingDef>SZ_Firecracker</ThingDef>
    </descriptionHyperlinks>
    <statBases>
      <MoveSpeed>4.5</MoveSpeed>
      <ArmorRating_Sharp>0.8</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.6</ArmorRating_Blunt>
      <IncomingDamageFactor>0.1</IncomingDamageFactor>
    </statBases>
    <damageMultipliers>
      <li>
        <damageDef>SZ_Firecracker_Flame</damageDef>
        <multiplier>1000</multiplier>
      </li>
      <li>
        <damageDef>SZ_Firecracker_FlameB</damageDef>
        <multiplier>1000</multiplier>
      </li>
      <li>
        <damageDef>SZ_Firecracker_FlameC</damageDef>
        <multiplier>1000</multiplier>
      </li>
      <li>
        <damageDef>AntiEvilBeastBullet</damageDef>
        <multiplier>6</multiplier>
      </li>
    </damageMultipliers>
    <race>
      <thinkTreeMain>SZ_AIYearBeast</thinkTreeMain>
      <body>QuadrupedAnimalWithHoovesAndHorn</body>
    </race>
    <tools>
      <li>
        <label>horn</label>
        <capacities>
          <li>Scratch</li>
          <li>Stab</li>
        </capacities>
        <power>80</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HornAttackTool</linkedBodyPartsGroup>
      </li>
      <li>
        <label>bite</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>60</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.7</chanceFactor>
      </li>
      <li>
        <label>left claw</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>25</power>
        <cooldownTime>1</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right claw</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>25</power>
        <cooldownTime>1</cooldownTime>
        <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
      </li>
    </tools>
    <comps>
      <li Class="AncientChineseBeast.CompProperties_ConnaturalAbilities">
        <abilities>
          <li>SZ_YearBeast_Flamethrower</li>
        </abilities>
      </li>
      <li Class="AncientChineseBeast.CompProperties_GenesInCorpse">
        <genes>
          <li>SZGene_YearBeast_Flamethrower</li>
          <li>SZGene_YearBeast_Skin</li>
          <li>SZGene_YearBeast_Horn</li>
        </genes>
      </li>
    </comps>
  </ThingDef>

  <ThingDef>
    <defName>SZ_YearBeastFlame</defName>
    <label>flame</label>
    <description>flame</description>
    <thingClass>AncientChineseBeast.YearFlame</thingClass>
    <graphicData>
      <texPath>AncientChineseBeast/YearBeast/Flame</texPath>
      <graphicClass>AncientChineseBeast.Graphic_Animation</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>(35,35)</drawSize>
      <color>(255,255,255,200)</color>
    </graphicData>
    <category>Item</category>
    <altitudeLayer>PawnUnused</altitudeLayer>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>SZ_YearBeastFlameProjectile</defName>
    <label>flame</label>
    <thingClass>AncientChineseBeast.YearFlameProjectile</thingClass>
