    </graphicData>
    <projectile>
      <speed>100</speed>
      <damageDef>Flame</damageDef>
      <damageAmountBase>15</damageAmountBase>
      <armorPenetrationBase>1</armorPenetrationBase>
    </projectile>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
