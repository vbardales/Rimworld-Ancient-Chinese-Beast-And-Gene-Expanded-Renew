<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef Name="SZBeastParent" ParentName="AnimalThingBase" Abstract="True">
    <modExtensions>
      <li Class="AncientChineseBeast.DefModExtension_PreventPermanentInjuries"/>
    </modExtensions>
    <statBases>
      <Wildness>5</Wildness>
      <MarketValue>2000</MarketValue>
      <ComfyTemperatureMin>-273</ComfyTemperatureMin>
      <ComfyTemperatureMax>500</ComfyTemperatureMax>
      <FilthRate>0</FilthRate>
      <Flammability>0</Flammability>
      <Mass>5000</Mass>
      <PsychicSensitivity>0</PsychicSensitivity>
      <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
      <ToxicResistance>1</ToxicResistance>
    </statBases>
    <race>
      <ageGenerationCurve>
        <points>
          <li>(1000,0)</li>
          <li>(1100,20)</li>
          <li>(1500,40)</li>
          <li>(1700,20)</li>
          <li>(1800,10)</li>
          <li>(2000,0)</li>
        </points>
      </ageGenerationCurve>
      <herdMigrationAllowed>false</herdMigrationAllowed>
      <foodType>CarnivoreAnimal, OvivoreAnimal</foodType>
      <predator>false</predator>
      <baseHealthScale>40</baseHealthScale>
      <baseHungerRate>0</baseHungerRate>
      <trainability>Advanced</trainability>
      <!-- Rest and breeding, from 2026-09-25: this parent no longer switches off needsRest or hasGenders, so every beast, hostile or tame, rests and has two sexes.
           Mating is slow on purpose (about every ten days for a fertile adult, twenty days of gestation, one young), so that the extractor's clone recipe stays the way to a beast today.
           A newborn is a baby of its race and grows to an adult in about fifteen days (ages are in years: 0, 0.06, 0.25), on the same textures at a smaller size. -->
      <mateMtbHours>240</mateMtbHours>
      <gestationPeriodDays>20</gestationPeriodDays>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(1.49, 0)</li>
        </points>
      </litterSizeCurve>
      <baseBodySize>20</baseBodySize>
      <lifeExpectancy>5000</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.06</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.25</minAge>
          <soundWounded>Pawn_Bear_Injured</soundWounded>
          <soundDeath>Pawn_Bear_Death</soundDeath>
          <soundCall>Pawn_Bear_Call</soundCall>
          <soundAngry>Pawn_Bear_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
  </ThingDef>

  <PawnKindDef Name ="SZBeast_PawnKindParent" ParentName="AnimalKindBase" Abstract="True">
    <minGenerationAge>1000</minGenerationAge>
    <maxGenerationAge>2000</maxGenerationAge>
    <canArriveManhunter>false</canArriveManhunter>
    <allowOldAgeInjuries>false</allowOldAgeInjuries>
  </PawnKindDef>
</Defs>
