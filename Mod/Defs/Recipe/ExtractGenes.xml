<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <RecipeDef Name="SZ_ExtractGeneRecipe" Abstract="True">
    <jobString>extracting a gene from a beast</jobString>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <workAmount>1</workAmount>
    <workSkill>Crafting</workSkill>
    <products>
      <Genepack>1</Genepack>
    </products>
    <recipeUsers>
      <li>SZ_BeastGeneExtractor</li>
    </recipeUsers>
  </RecipeDef>

  <RecipeDef>
    <defName>SZ_ExtractGene</defName>
    <label>extract archite capsules</label>
    <description>Use the peculiar factors in the corpses of the Shenzhou beasts to extract archite capsules.</description>
    <jobString>extracting a gene from a beast</jobString>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <workAmount>1</workAmount>
    <workSkill>Crafting</workSkill>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Corpse_SZ_YearBeast</li>
        <li>Corpse_SZ_QiongQi</li>
        <li>Corpse_SZ_MingShe</li>
        <li>Corpse_SZ_SeXieInsect</li>
      </thingDefs>
    </fixedIngredientFilter>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Corpse_SZ_YearBeast</li>
            <li>Corpse_SZ_QiongQi</li>
            <li>Corpse_SZ_MingShe</li>
            <li>Corpse_SZ_SeXieInsect</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <products>
      <ArchiteCapsule>10</ArchiteCapsule>
    </products>
    <recipeUsers>
      <li>SZ_BeastGeneExtractor</li>
    </recipeUsers>
  </RecipeDef>
  
  
  <RecipeDef ParentName="SZ_ExtractGeneRecipe">
    <defName>SZ_ExtractGene_YearA</defName>
    <label>extract nian beast fire breath gene</label>
    <description>Extract the gene from a nian beast's corpse and obtain its fire breath.</description>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Corpse_SZ_YearBeast</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <modExtensions>
      <li Class="AncientChineseBeast.DefModExtension_Genes">
        <gene>SZGene_YearBeast_Flamethrower</gene>
      </li>
    </modExtensions>
  </RecipeDef>

