<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseMakeableGrenade">
    <defName>SZ_Firecracker</defName>
    <label>firecracker</label>
    <description>A festival item out of the Shenzhou regions. Traditionally a firecracker is only for celebrating the Spring Festival and adding to the noise; on the rim it has picked up something of a weapon's character, since it throws out flame and blast damage when it goes off. \n\nFirecrackers can be made at a crafting spot or a smithy. For a colony still at a medieval level, or simply short of weapons, a firecracker is a poor man's grenade launcher - with a smaller blast radius than a real grenade. It is also the answer to the nian beast, which is terrified of them. (A nian beast shrugs off nine tenths of any other weapon; firecracker fire is the one thing that goes through.)</description>
    <recipeMaker>
      <recipeUsers>
        <li>CraftingSpot</li>
      </recipeUsers>
    </recipeMaker>
    <techLevel>Neolithic</techLevel>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>AncientChineseBeast/Firecracker</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconScale>1.3</uiIconScale>
    <soundInteract>Interact_Grenade</soundInteract>
    <statBases>
      <Mass>1</Mass>
      <RangedWeapon_Cooldown>2.2</RangedWeapon_Cooldown>
      <WorkToMake>2000</WorkToMake>
    </statBases>
    <costList>
      <WoodLog>20</WoodLog>
    </costList>
    <thingCategories>
      <li>WeaponsRanged</li>
    </thingCategories>
    <verbs>
      <li>
        <label>throw firecracker</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>27.9</range>
        <forcedMissRadius>1.9</forcedMissRadius>
        <warmupTime>1.5</warmupTime>
        <noiseRadius>4</noiseRadius>
        <ai_IsBuildingDestroyer>false</ai_IsBuildingDestroyer>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <defaultProjectile>SZ_FirecrackerProjectile</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>1.6</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
      </li>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>0.8</explosiveRadius>
        <explosiveDamageType>Flame</explosiveDamageType>
        <requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
      </li>
      <li>
        <compClass>AncientChineseBeast.CompSZBeastDebug</compClass>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseGrenadeProjectile">
    <defName>SZ_FirecrackerProjectile</defName>
    <label>firecracker</label>
    <graphicData>
      <texPath>AncientChineseBeast/FirecrackerProjectile</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <explosionRadius>6.9</explosionRadius>
      <damageDef>SZ_Firecracker_Flame</damageDef>
      <!-- Use default damage from explosion def -->
      <soundExplode>SZ_Firecracker</soundExplode>
      <explosionDelay>100</explosionDelay>
    </projectile>
  </ThingDef>

  <ThingDef>
    <defName>SZ_Firecracker_Explosion</defName>
    <label>explosion</label>
    <description>explosion</description>
    <thingClass>AncientChineseBeast.Firecracker</thingClass>
    <category>Projectile</category>
    <altitudeLayer>LayingPawn</altitudeLayer>
    <drawerType>None</drawerType>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
  </ThingDef>
</Defs>