<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>SZ_ScorpionPoison</defName>
    <label>horse-felling venom</label>
    <description>The venom a sexie carries. It drops an enemy to the ground in pain.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.7, 1.0, 0.7)</defaultLabelColor>
    <makesSickThought>true</makesSickThought>
    <scenarioCanAdd>true</scenarioCanAdd>
    <taleOnVisible>ToxicityRevealed</taleOnVisible>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <painOffset>1</painOffset>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SZ_Strength</defName>
    <label>monstrous strength</label>
    <description>Monstrous strength. It doubles the damage of the bearer's unarmed blows.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1.0, 0.2, 0)</defaultLabelColor>
    <stages>
      <li>
        <statFactors>
          <MeleeDamageFactor>2</MeleeDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>
