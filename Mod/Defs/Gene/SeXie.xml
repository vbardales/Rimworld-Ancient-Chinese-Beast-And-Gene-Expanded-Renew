<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <GeneDef>
    <defName>SZGene_SeXie_Shoot</defName>
    <label>sexie crystal spurs</label>
    <description>The sexie's sting gene. The bearer can kill at range with the same sharp venomous needles.</description>
    <iconPath>AncientChineseBeast/SeXie/ShootIcon</iconPath>
    <displayCategory>Archite</displayCategory>
    <marketValueFactor>1.5</marketValueFactor>
    <abilities>
      <li>SZ_SeXieShootA</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>SZ_SeXieShootA</AbilityDef>
    </descriptionHyperlinks>
    <renderNodeProperties>
      <li>
        <texPath>AncientChineseBeast/SeXie/Tail</texPath>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <parentTagDef>Body</parentTagDef>
        <drawSize>1</drawSize>
        <drawData>
          <dataNorth>
            <offset>(0, 0.3, 0)</offset>
          </dataNorth>
          <dataSouth>
            <offset>(0, -0.3, 0)</offset>
          </dataSouth>
          <dataWest>
            <flip>true</flip>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
    <biostatCpx>10</biostatCpx>
    <biostatMet>-3</biostatMet>
    <biostatArc>1</biostatArc>
    <symbolPack>
      <wholeNameSymbols>
        <li>
          <symbol>色邪的祝福</symbol>
        </li>
        <li>
          <symbol>色邪的恩赐</symbol>
        </li>
      </wholeNameSymbols>
    </symbolPack>
    <randomChosen>false</randomChosen>
  </GeneDef>

  <GeneDef>
