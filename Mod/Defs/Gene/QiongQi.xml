<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <GeneDef>
    <defName>SZGene_QiongQi_FlyingStrike</defName>
    <label>qiongqi flying strike</label>
    <description>The flying strike, extracted by gene engineering. The bearer can throw themselves at an enemy's back line the way a qiongqi does, tearing the line open. Usually hits the head.</description>
    <iconPath>AncientChineseBeast/QiongQi/FlyingSrikeIcon</iconPath>
    <displayCategory>Archite</displayCategory>
    <marketValueFactor>1.5</marketValueFactor>
    <abilities>
      <li>SZ_QiongQi_FlyingStrike</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>SZ_QiongQi_FlyingStrike</AbilityDef>
    </descriptionHyperlinks>
    <renderNodeProperties>
      <li>
        <texPath>AncientChineseBeast/QiongQi/Wing</texPath>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <parentTagDef>Body</parentTagDef>
        <drawSize>2</drawSize>
        <drawData>
          <dataNorth>
            <offset>(0, 0.3, 0)</offset>
          </dataNorth>
          <dataSouth>
            <offset>(0, -0.3, 0)</offset>
          </dataSouth>
          <dataWest>
            <flip>true</flip>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
    <biostatCpx>10</biostatCpx>
    <biostatMet>-2</biostatMet>
    <biostatArc>1</biostatArc>
    <symbolPack>
      <wholeNameSymbols>
        <li>
          <symbol>穷奇的祝福</symbol>
        </li>
        <li>
          <symbol>穷奇的恩赐</symbol>
        </li>
      </wholeNameSymbols>
    </symbolPack>
    <randomChosen>false</randomChosen>
  </GeneDef>

  <GeneDef>
    <defName>SZGene_QiongQi_Eyes</defName>
    <label>qiongqi eye</label>
    <description>The qiongqi eye, extracted by gene engineering, gives its bearer the beast's sight - and with it a high chance of dodging melee and ranged attacks alike.</description>
    <iconPath>AncientChineseBeast/QiongQi/EyesIcon</iconPath>
    <displayCategory>Archite</displayCategory>
    <marketValueFactor>1.5</marketValueFactor>
    <biostatCpx>10</biostatCpx>
    <biostatMet>-4</biostatMet>
    <biostatArc>1</biostatArc>
    <symbolPack>
      <wholeNameSymbols>
        <li>
          <symbol>穷奇的祝福</symbol>
        </li>
        <li>
          <symbol>穷奇的恩赐</symbol>
        </li>
      </wholeNameSymbols>
    </symbolPack>
    <randomChosen>false</randomChosen>
  </GeneDef>

  <GeneDef>
    <defName>SZGene_QiongQi_Scratch</defName>
    <label>qiongqi claws</label>
    <description>The qiongqi's sharp claws. They open an enemy's armour easily and greatly raise armour penetration in melee. Usually hits the head.</description>
    <iconPath>AncientChineseBeast/QiongQi/ScratchIcon</iconPath>
    <displayCategory>Archite</displayCategory>
    <marketValueFactor>1.5</marketValueFactor>
    <geneClass>AncientChineseBeast.Gene_Hediffs</geneClass>
    <descriptionHyperlinks>
      <HediffDef>SZ_QiongQi_Scratch</HediffDef>
    </descriptionHyperlinks>
    <modExtensions>
      <li Class="AncientChineseBeast.DefModExtension_GeneHediffs">
        <hediffs>
          <li>
            <bodyPart>Hand</bodyPart>
            <hediff>SZ_QiongQi_Scratch</hediff>
          </li>
        </hediffs>
      </li>
    </modExtensions>
    <biostatCpx>10</biostatCpx>
    <biostatMet>-3</biostatMet>
    <biostatArc>1</biostatArc>
    <symbolPack>
      <wholeNameSymbols>
        <li>
          <symbol>年兽的祝福</symbol>
        </li>
        <li>
          <symbol>年兽的恩赐</symbol>
        </li>
      </wholeNameSymbols>
    </symbolPack>
    <randomChosen>false</randomChosen>
  </GeneDef>

</Defs>