<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- Assembly name and namespace are kept: every def in the mod names its classes as
         AncientChineseBeast.*, and renaming either would break all 133 of them. -->
    <AssemblyName>AncientChineseBeast</AssemblyName>
    <RootNamespace>AncientChineseBeast</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Configuration>Release</Configuration>
    <!-- Mod/ is what the Workshop uploader publishes; Source/ deliberately sits outside it. -->
    <OutputPath>..\Mod\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>CS0169;CS0649;CS0414;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*-*" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
