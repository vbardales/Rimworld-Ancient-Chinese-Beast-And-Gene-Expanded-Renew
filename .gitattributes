# Normalise line endings inside the repository, while letting each machine keep its own.
* text=auto

*.cs    text diff=csharp
*.xml   text
*.md    text
*.props text
*.yml   text

# Binaries: neither normalised nor diffed as text.
*.png binary
*.jpg binary
*.dll binary
*.wav binary
*.mp3 binary

# Pickle pass maps are read line by line by bash in the WSL install, which stages from this working copy: a
# CR left at the end of a packageId is part of the id. Keep them LF whatever the machine.
*.map text eol=lf
