<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Never published: Mod/ is what the Workshop uploader sends, and this project sits outside it.
    No test framework either, on purpose. These checks load the built assembly and RimWorld's own
    against each other by reflection; they never construct a Thing, never touch Unity, and never
    need a running game. A framework would add a restore and a runner without adding a single
    thing they can assert.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>AncientChineseBeast.Tests</AssemblyName>
    <RootNamespace>AncientChineseBeast.Tests</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Tests/Pickle/ is a different project: net48 step sources that reference Pickle and the game, built by
    Tests/Pickle/Source/*.csproj into a companion mod. An SDK project compiles every .cs under its folder,
    so without this line the offline suite tries to build them as net8 and fails on the first `using`.
    It went unseen for a while: Tests/Run-All.ps1 last ran green before Tests/Pickle/Source existed.
  -->
  <ItemGroup>
    <Compile Remove="Pickle\**" />
    <None Remove="Pickle\**" />
    <!-- Tests/build/ holds the intermediates of the Pickle step build (ignored by git); its generated
         AssemblyAttributes.cs carries a second TargetFrameworkAttribute (CS0579). -->
    <Compile Remove="build\**" />
    <None Remove="build\**" />
  </ItemGroup>

</Project>
